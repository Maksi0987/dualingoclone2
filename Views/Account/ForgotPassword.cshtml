@{
    ViewData["Title"] = "Відновлення пароля";
    Layout = null; // Цей рядок прибирає ліву панель!
}

<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Languio</title>

    <!-- Підключення шрифту Nunito -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&display=swap" rel="stylesheet">

    <!-- Підключення Bootstrap та іконок -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
            body {
                font-family: 'Nunito', sans-serif;
                background-color: #f7f7f7; /* Світло-сірий фон, щоб біла картка виділялася */
            }
    </style>
</head>
<body>

    <div class="container d-flex justify-content-center align-items-center py-5" style="min-height: 100vh;">
        <div class="card border-2 border-secondary-subtle rounded-4 shadow-sm p-4 p-md-5 bg-white" style="max-width: 450px; width: 100%;">

            <div class="text-center mb-4">
                <i class="bi bi-key-fill text-primary" style="font-size: 3rem;"></i>
            </div>

            <h3 class="fw-black text-center mb-3" style="font-weight: 900;">Забули пароль?</h3>
            <p class="text-secondary text-center fw-bold mb-4">
                Введіть електронну пошту, прив'язану до вашого акаунту, і ми надішлемо вам посилання для скидання пароля.
            </p>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger rounded-4 fw-bold p-3 mb-4">
                    @Html.ValidationSummary(false, "", new { @class = "text-danger m-0 p-0", style = "list-style-type: none;" })
                </div>
            }

            @if (TempData["StatusMessage"] != null)
            {
                <div class="alert alert-success rounded-4 fw-bold p-3 mb-4">
                    @TempData["StatusMessage"]
                </div>
            }

            <form asp-action="ForgotPassword" method="post">
                <div class="mb-4">
                    <input type="email" name="email" class="form-control form-control-lg rounded-4 fw-bold border-2 p-3" placeholder="Електронна пошта" required />
                </div>

                <button type="submit" class="btn btn-primary w-100 py-3 rounded-4 fw-extrabold text-uppercase mb-4">
                    Надіслати посилання
                </button>

                <div class="text-center">
                    <a asp-controller="Account" asp-action="Login" class="text-decoration-none fw-extrabold text-secondary small text-uppercase">
                        <i class="bi bi-arrow-left me-1"></i> Повернутися до входу
                    </a>
                </div>
            </form>
        </div>
    </div>

</body>
</html>