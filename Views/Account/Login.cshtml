@model Languio.Models.LoginViewModel

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-4">
            <h2 class="text-center mb-4">Вхід</h2>
            <form asp-controller="Account" asp-action="Login" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="mb-3">
                    <input asp-for="EmailOrUsername" class="form-control" placeholder="Ел. адреса або ім'я користувача" />
                    <span asp-validation-for="EmailOrUsername" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <input asp-for="Password" class="form-control" placeholder="Пароль" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                <button type="submit" class="btn btn-primary w-100">УВІЙТИ</button>
            </form>
        </div>
    </div>
</div>