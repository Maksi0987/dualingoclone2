@model Languio.Models.RegisterViewModel
@{
    ViewData["Title"] = "Реєстрація";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow-sm" style="border-radius: 15px;">
                <div class="card-body p-4">
                    <h2 class="text-center mb-4 fw-bold">Створити акаунт</h2>
                    <form asp-controller="Account" asp-action="Register" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-bold">Email</label>
                            <input asp-for="Email" class="form-control form-control-lg" placeholder="Введіть ваш email" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label fw-bold">Пароль</label>
                            <input asp-for="Password" class="form-control form-control-lg" placeholder="Введіть пароль" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ConfirmPassword" class="form-label fw-bold">Підтвердження пароля</label>
                            <input asp-for="ConfirmPassword" class="form-control form-control-lg" placeholder="Повторіть пароль" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 btn-lg" style="border-radius: 15px; font-weight: bold;">Зареєструватися</button>

                        <div class="text-center mt-3">
                            <p class="text-muted">Вже є акаунт? <a asp-controller="Account" asp-action="Login" class="text-decoration-none fw-bold">Увійти</a></p>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>