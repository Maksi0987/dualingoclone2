@model Languio.Models.LanguageLessonGroup
@{
    ViewData["Title"] = "Додати новий розділ";
    Layout = "_AdminLayout";
    int courseId = ViewBag.CourseId;
}

<div class="container-fluid min-vh-100 bg-white d-flex align-items-center justify-content-center p-4">
    <div class="w-100" style="max-width: 550px;">

        <nav class="mb-3 text-center">
            <a asp-action="Groups" asp-route-courseId="@courseId" class="text-info fw-bold text-decoration-none small">
                <i class="bi bi-arrow-left"></i> Назад до розділів
            </a>
        </nav>

        <h1 class="h3 fw-extrabold mb-4 text-dark text-center d-flex align-items-center justify-content-center gap-2" style="font-family: 'Nunito', sans-serif;">
            <span>📁</span> Додати новий розділ (Групу)
        </h1>

        <form asp-action="CreateGroup" method="post" class="card dl-light-card p-4 rounded-4 shadow-sm border-2">
            <input type="hidden" name="LanguageCourseId" value="@courseId" />

            <div class="mb-3">
                <label asp-for="Title" class="form-label fw-extrabold text-secondary small text-uppercase mb-2" style="letter-spacing: 0.8px;">Назва розділу</label>
                <input asp-for="Title" class="form-control dl-light-input py-2.5 text-dark fw-bold" placeholder="Наприклад: Зробіть замовлення в кафе" required autocomplete="off" />
            </div>

            <div class="d-flex justify-content-end gap-3 border-top border-2 border-light-subtle pt-4">
                <a asp-action="Groups" asp-route-courseId="@courseId" class="btn btn-3d-light text-uppercase fw-extrabold px-4 py-2.5 rounded-3 fs-7 text-decoration-none flex-grow-1 text-center">Скасувати</a>
                <button type="submit" class="btn btn-3d-green text-uppercase fw-extrabold px-4 py-2.5 rounded-3 fs-7 flex-grow-1">Зберегти</button>
            </div>
        </form>

    </div>
</div>