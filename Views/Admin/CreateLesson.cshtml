@model Languio.Models.LanguageLesson
@{
    ViewData["Title"] = "Додати новий урок";
    Layout = "_AdminLayout";
    int groupId = ViewBag.GroupId;
}

<div class="container-fluid min-vh-100 bg-white d-flex align-items-center justify-content-center p-4">
    <div class="w-100" style="max-width: 500px;">

        <nav class="mb-3 text-center">
            <a asp-action="Lessons" asp-route-groupId="@groupId" class="text-info fw-bold text-decoration-none small">
                <i class="bi bi-arrow-left"></i> Назад до уроків
            </a>
        </nav>

        <h1 class="h3 fw-extrabold mb-4 text-dark text-center d-flex align-items-center justify-content-center gap-2" style="font-family: 'Nunito', sans-serif;">
            <span>📍</span> Додати урок у модуль
        </h1>

        <form asp-action="CreateLesson" method="post" class="card dl-light-card p-4 rounded-4 shadow-sm border-2">
            <input type="hidden" name="LanguageLessonGroupId" value="@groupId" />

            <div class="mb-3">
                <label asp-for="Title" class="form-label fw-extrabold text-secondary small text-uppercase mb-2" style="letter-spacing: 0.8px;">Назва або фокус уроку</label>
                <input asp-for="Title" class="form-control dl-light-input py-2.5 text-dark fw-bold" placeholder="Наприклад: Знайомство з меню" required autocomplete="off" />
            </div>

            <div class="d-flex justify-content-end gap-3 border-top border-2 border-light-subtle pt-4">
                <a asp-action="Lessons" asp-route-groupId="@groupId" class="btn btn-3d-light text-uppercase fw-extrabold px-4 py-2.5 rounded-3 fs-7 text-decoration-none flex-grow-1 text-center">Скасувати</a>
                <button type="submit" class="btn btn-3d-green text-uppercase fw-extrabold px-4 py-2.5 rounded-3 fs-7 flex-grow-1">Створити урок</button>
            </div>
        </form>

    </div>
</div>