@model IEnumerable<Languio.Models.LanguageLessonGroup>
@{
    ViewData["Title"] = "Адмінка - Розділи";
    Layout = "_AdminLayout";
}

<div class="container-fluid min-vh-100 bg-white text-dark p-5">
    <div class="mx-auto" style="max-width: 900px;">

        <nav class="mb-3"><a asp-action="Index" class="text-info fw-bold text-decoration-none small"><i class="bi bi-arrow-left"></i> Назад до курсів</a></nav>

        <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom border-2 border-light-subtle">
            <h1 class="h3 fw-extrabold text-dark m-0" style="font-family: 'Nunito', sans-serif;">
                Розділи курсу <span class="text-success text-uppercase">@ViewBag.CourseName</span>
            </h1>
            <a asp-action="CreateGroup" asp-route-courseId="@ViewBag.CourseId" class="btn btn-3d-green text-uppercase fw-extrabold px-4 py-2 rounded-3 fs-7 text-decoration-none">
                + Додати розділ
            </a>
        </div>

        <div class="d-flex flex-column gap-3">
            @if (!Model.Any())
            {
                <div class="p-5 text-center text-secondary border border-2 border-dashed border-secondary-subtle rounded-4 bg-light bg-opacity-50">У цьому курсі ще немає створених розділів.</div>
            }

            @foreach (var group in Model)
            {
                <div class="rounded-4 border-2 p-3 p-md-4 d-flex justify-content-between align-items-center dl-light-row transition-all mb-1">
                    <a asp-action="Lessons" asp-route-groupId="@group.Id" class="d-flex align-items-center gap-3 text-decoration-none flex-grow-1">
                        <span class="fs-2">📂</span>
                        <div>
                            <h5 class="fw-extrabold m-0 text-dark">@group.Title</h5>
                            <small class="text-secondary fw-bold small">Керування уроками цього розділу</small>
                        </div>
                    </a>
                    <div class="d-flex align-items-center gap-2 gap-md-3 ps-3 border-start border-2 border-light-subtle">
                        <a asp-action="EditGroup" asp-route-id="@group.Id" class="btn btn-sm btn-outline-primary fw-bold rounded-3 d-flex align-items-center justify-content-center border-2" style="width: 38px; height: 38px; transition: all 0.2s;" title="Редагувати">
                            <i class="bi bi-pencil-fill"></i>
                        </a>
                        <form asp-action="DeleteGroup" asp-route-id="@group.Id" method="post" onsubmit="return confirm('Ви впевнені? Усі уроки в розділі будуть видалені!');" class="m-0">
                            <button type="submit" class="btn btn-sm btn-outline-danger fw-bold rounded-3 d-flex align-items-center justify-content-center border-2" style="width: 38px; height: 38px; transition: all 0.2s;" title="Видалити розділ">
                                <i class="bi bi-trash-fill fs-6"></i>
                            </button>
                        </form>
                        <a asp-action="Lessons" asp-route-groupId="@group.Id" class="text-success fw-extrabold fs-5 text-decoration-none"><i class="bi bi-chevron-right"></i></a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>