@model IEnumerable<Languio.Models.LanguageCourse>

        
@{
    ViewData["Title"] = "Управління курсами";
}

<!-- Кнопка повернення на головну -->
<div class="mb-4">
    <a asp-controller="Learn" asp-action="Index" class="btn btn-outline-secondary rounded-4 fw-extrabold px-4 py-2 border-2">
        <i class="bi bi-arrow-left me-2"></i> Повернутися до навчання
    </a>
</div>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-extrabold m-0">📚 Управління курсами</h2>
    <a asp-action="CreateCourse" class="btn btn-success fw-extrabold rounded-4 px-4 py-2 text-uppercase">
        + Додати курс
    </a>
</div>

<!-- ... далі йде твій існуючий код списку курсів ... -->

        <div class="d-flex flex-column gap-3">
            @if (!Model.Any())
            {
                <div class="p-5 text-center text-secondary border border-2 border-dashed border-secondary-subtle rounded-4 bg-light bg-opacity-50">Курсів поки немає. Натисніть "+ Додати курс", щоб створити перший.</div>
            }

            @foreach (var course in Model)
            {
                <div class="rounded-4 border-2 p-3 p-md-4 d-flex justify-content-between align-items-center dl-light-row transition-all mb-1">
                    <a asp-action="Groups" asp-route-courseId="@course.Id" class="d-flex align-items-center gap-3 text-decoration-none flex-grow-1">
                        <span class="fs-2">🌐</span>
                        <div>
                            <h5 class="fw-extrabold m-0 text-dark text-uppercase" style="letter-spacing: 0.5px;">Курс: @course.LanguageCode</h5>
                            <small class="text-secondary fw-bold small">Керування розділами та структурою уроків</small>
                        </div>
                    </a>
                    <div class="d-flex align-items-center gap-3 ps-3 border-start border-2 border-light-subtle">
                        <a asp-action="EditCourse" asp-route-id="@course.Id" class="btn btn-sm btn-outline-primary fw-bold rounded-3 d-flex align-items-center justify-content-center border-2" style="width: 38px; height: 38px; transition: all 0.2s;" title="Редагувати">
                            <i class="bi bi-pencil-fill"></i>
                        </a>
                        <form asp-action="DeleteCourse" asp-route-id="@course.Id" method="post" onsubmit="return confirm('Ви впевнені? УСІ розділи та уроки будуть видалені!');" class="m-0">
                            <button type="submit" class="btn btn-sm btn-outline-danger fw-bold rounded-3 d-flex align-items-center justify-content-center border-2" style="width: 38px; height: 38px; transition: all 0.2s;" title="Видалити курс">
                                <i class="bi bi-trash-fill fs-6"></i>
                            </button>
                        </form>
                        <a asp-action="Groups" asp-route-courseId="@course.Id" class="text-success fw-extrabold fs-5 text-decoration-none"><i class="bi bi-chevron-right"></i></a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>