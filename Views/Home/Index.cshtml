@{
    ViewData["Title"] = "Безкоштовне вивчення мов - Languio";
    Layout = null; // Вимикаємо стандартний Layout, щоб сторінка була чистою, як у Duolingo
}

<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
            .duo-btn-start {
                background-color: #58cc02;
                color: white;
                border: 2px solid #58cc02;
                border-bottom: 4px solid #58a700;
                border-radius: 15px;
            }
            .duo-btn-start:hover {
                background-color: #46a302;
                color: white;
            }
            .duo-btn-login {
                background-color: white;
                color: #1cb0f6;
                border: 2px solid #e5e5e5;
                border-bottom: 4px solid #e5e5e5;
                border-radius: 15px;
            }
            .duo-btn-login:hover {
                background-color: #f7f7f7;
                color: #1cb0f6;
            }
    </style>
</head>
<body>
    <div class="container d-flex flex-column min-vh-100">
        <!-- Шапка -->
        <header class="d-flex justify-content-between align-items-center py-4">
            <h2 class="fw-bold m-0" style="color: #58cc02;">languio</h2>
            <div class="dropdown">
                <button class="btn btn-light text-secondary fw-bold border-0 bg-transparent" type="button">
                    МОВА САЙТУ: УКРАЇНСЬКА <span>▼</span>
                </button>
            </div>
        </header>

        <!-- Головний контент -->
        <main class="row flex-grow-1 align-items-center justify-content-center text-center text-md-start">
            <div class="col-md-5 d-flex justify-content-center mb-5 mb-md-0">
                <!-- Картинка Хамелеона (шлях з твого архіву) -->
                <img src="~/images/mascot.gif" alt="Languio Mascot" class="img-fluid" style="max-width: 350px;">
            </div>
            <div class="col-md-5 d-flex flex-column align-items-center align-items-md-center">
                <h1 class="fw-bold mb-5 text-dark text-center" style="font-size: 2.2rem; line-height: 1.4;">
                    Безкоштовний, веселий та<br>ефективний спосіб<br>вивчення мови!
                </h1>

                <div class="d-grid gap-3 w-75">
                    <!-- Кнопка "РОЗПОЧАТИ" -> ВЕДЕ НА РЕЄСТРАЦІЮ -->
                    <a asp-controller="Account" asp-action="Register" class="btn duo-btn-start fw-bold py-3 fs-6">
                        РОЗПОЧАТИ
                    </a>

                    <!-- Кнопка "ВЖЕ МАЮ ОБЛІКОВИЙ ЗАПИС" -> ВЕДЕ НА ЛОГІН -->
                    <a asp-controller="Account" asp-action="Login" class="btn duo-btn-login fw-bold py-3 fs-6">
                        ВЖЕ МАЮ ОБЛІКОВИЙ ЗАПИС
                    </a>
                </div>
            </div>
        </main>

        <!-- Футер з мовами -->
        <footer class="py-4 border-top text-center mt-auto">
            <div class="d-flex justify-content-center flex-wrap gap-4 fw-bold text-secondary" style="font-size: 0.85rem;">
                <span>US АНГЛІЙСЬКА</span>
                <span>ES ІСПАНСЬКА</span>
                <span>FR ФРАНЦУЗЬКА</span>
                <span>DE НІМЕЦЬКА</span>
                <span>IT ІТАЛІЙСЬКА</span>
                <span>BR ПОРТУГАЛЬСЬКА</span>
            </div>
        </footer>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>