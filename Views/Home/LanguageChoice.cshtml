@model Languio.Models.ChooseLanguageViewModel
@{
    ViewData["Title"] = "Яку мову ви хочете вчити?";
    Layout = "_StylesLayout";
}

<div class="container-fluid min-vh-100 bg-white d-flex flex-column">
    <header class="container d-flex justify-content-between align-items-center py-4 px-3 border-bottom border-light-subtle">
        <div class="logo fw-extrabold text-success fs-2" style="letter-spacing: -1.5px; cursor:pointer;" onclick="location.href='/'">languio</div>
    </header>

    <main class="container my-auto py-5" style="max-width: 800px;">
        <h1 class="text-center fw-extrabold h3 mb-5 text-dark" style="font-family: 'Nunito', sans-serif;">
            Яку мову ви хочете вчити?
        </h1>

        <form id="langForm" asp-controller="Home" asp-action="SelectLanguage" method="post">
            <input type="hidden" id="selectedLangInput" name="lang" value="" />

            <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 g-4 justify-content-center">
                @foreach (var lang in Model.Languages)
                {
                    var flagClass = lang.Code == "en" ? "fi-us" : $"fi-{lang.Code}";
                    <div class="col">
                        <div class="card h-100 text-center p-4 border-2 rounded-4 shadow-sm dl-lang-card"
                             style="cursor: pointer; transition: all 0.2s;"
                             onclick="submitLanguage('@lang.Code')">

                            <div class="card-body p-0 d-flex flex-column align-items-center justify-content-center">
                                @if (!string.IsNullOrEmpty(flagClass))
                                {
                                    <span class="fi @flagClass fis" style="font-size: 1.5rem;"></span>
                                }
                                else
                                {
                                    <i class="bi bi-globe fs-3"></i>
                                }
                                <h5 class="card-title fw-extrabold fs-6 m-0 text-dark">@lang.Name</h5>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </form>
    </main>
</div>

<style>
    .dl-lang-card {
        background-color: var(--bg-card) !important;
        border-color: var(--border-color) !important;
    }

        .dl-lang-card:hover {
            background-color: var(--hover-bg) !important;
            border-color: #1cb0f6 !important;
            transform: translateY(-5px);
        }

    .logo {
        font-family: 'Nunito', sans-serif;
    }
</style>

@section Scripts {
    <script>
        function submitLanguage(langCode) {
            localStorage.setItem("current_lang", langCode);
            document.getElementById("selectedLangInput").value = langCode;
            document.getElementById("langForm").submit();
        }
    </script>
}
