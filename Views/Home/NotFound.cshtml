@{
    ViewData["Title"] = "Сторінку не знайдено";
}

<div class="container-fluid min-vh-100 bg-white d-flex align-items-center justify-content-center p-4 text-center">
    <div style="max-width: 500px;">

        <div class="mb-4" style="font-size: 6rem;">
            🦎
        </div>

        <h1 class="fw-extrabold text-dark mb-3" style="font-family: 'Nunito', sans-serif; font-size: 2.5rem;">
            Упс! Сторінка зникла
        </h1>

        <p class="text-secondary fw-bold fs-5 mb-5">
            Схоже, ви перейшли за неправильним посиланням або ця сторінка була видалена.
        </p>

        <a asp-controller="Home" asp-action="Index" class="btn btn-3d-green text-uppercase fw-extrabold px-5 py-3 rounded-3 fs-6 text-decoration-none d-inline-block">
            Повернутися на головну
        </a>

    </div>
</div>