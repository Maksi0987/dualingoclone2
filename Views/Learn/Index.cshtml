@model Languio.Models.LearnViewModel
@{
    ViewData["Title"] = "Навчання";
}

@if (Model.LanguageLessonGroups == null || !Model.LanguageLessonGroups.Any())
{
    <div class="p-5 text-center text-secondary border border-2 border-dashed border-secondary-subtle rounded-4 my-5 bg-light">
        <h5 class="fw-bold">Курс поки порожній</h5>
        <p class="small m-0">Перейдіть в панель адміністратора, щоб додати розділи та уроки.</p>
    </div>
}
else
{
    int groupCounter = 1;
    foreach (var group in Model.LanguageLessonGroups)
    {
        var lessons = group.Lessons?.OrderBy(l => l.Order).ToList() ?? new List<LanguageLesson>();
        int[] shifts = new int[] { 0, -30, -55, -30, 0, 30, 55, 30 };
        bool isGroupLocked = Model.CurrentLanguageLesson != null && lessons.Any()
            && lessons.Min(l => l.Order) > Model.CurrentLanguageLesson.Order;

        if (isGroupLocked)
        {
            <div class="dl-section-divider mb-5">
                <span>@group.Title</span>
            </div>
        }
        else
        {
            <div class="dl-section-banner p-4 text-white rounded-4 d-flex justify-content-between align-items-center mb-5 shadow-sm">
                <div>
                    <div class="text-uppercase fw-extrabold small text-white-50 tracking-wider">Розділ @groupCounter</div>
                    <h2 class="h4 fw-extrabold m-0 mt-1">@group.Title</h2>
                </div>
            </div>
        }

        <div class="d-flex flex-column align-items-center gap-4 py-3 mb-5 position-relative">

            @if (!lessons.Any())
            {
                <div class="text-muted small fw-bold py-2">Уроків у цьому розділі ще немає...</div>
            }

            @for (int i = 0; i < lessons.Count; i++)
            {
                var lesson = lessons[i];
                int shiftX = shifts[i % shifts.Length];
                bool isCompleted = Model.CurrentLanguageLesson != null && lesson.Order < Model.CurrentLanguageLesson.Order;
                bool isActive = Model.CurrentLanguageLesson != null && lesson.Id == Model.CurrentLanguageLesson.Id;

                <div class="position-relative" style="transform: translateX(@(shiftX)px);">
                    @if (isActive)
                    {
                        <div class="dl-tooltip text-uppercase">Почати</div>
                        <a asp-controller="Lesson" asp-action="Start" asp-route-id="@lesson.Id"
                           class="btn dl-btn dl-btn-active rounded-circle d-flex align-items-center justify-content-center animate-bounce">
                            <i class="bi bi-star-fill text-white fs-4"></i>
                        </a>
                    }
                    else if (isCompleted)
                    {
                        <a asp-controller="Lesson" asp-action="Start" asp-route-id="@lesson.Id"
                           class="btn dl-btn dl-btn-active rounded-circle d-flex align-items-center justify-content-center animate-bounce">
                            <i class="bi bi-check-lg text-white fs-3"></i>
                        </a>
                    }
                    else
                    {
                        <a class="btn dl-btn dl-btn-locked rounded-circle d-flex align-items-center justify-content-center">
                            <i class="bi bi-play-fill fs-3 text-secondary"></i>
                        </a>
                    }
                </div>
            }
        </div>

        groupCounter++;
    }
}

@section RightSidebar {
    <div class="d-flex justify-content-between align-items-center fw-extrabold px-1 stats-row">
        <a asp-action="LanguageChoice" asp-controller="Home"
           class="d-flex align-items-center gap-2 text-dark fs-5 cursor-pointer rounded-3 px-2 py-1 hover-gray" title="Поточна мова">
            @{
                var flagClass = Model.LanguageCode == "en" ? "fi-us" : $"fi-{Model.LanguageCode}";
                @if (!string.IsNullOrEmpty(flagClass))
                {
                    <span class="fi @flagClass fis" style="font-size: 1.5rem;"></span>
                }
                else
                {
                    <i class="bi bi-globe fs-3"></i>
                }
            }
        </a>

        <span class="d-flex align-items-center gap-1.5 text-danger fs-5 rounded-3 px-2 py-1 hover-gray" title="Ударний режим (Дні)">
            <i class="bi bi-fire fs-4"></i> @Model.DayStreak
        </span>

        <span class="d-flex align-items-center gap-1.5 text-info fs-5 rounded-3 px-2 py-1 hover-gray" title="Лінгвоти (Монети)">
            <i class="bi bi-gem fs-4 text-cyan"></i> @Model.Coins
        </span>
    </div>
}