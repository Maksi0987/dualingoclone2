@model Languio.Models.LanguageLesson
@{
    ViewData["Title"] = Model.Title;
    Layout = null;
}

<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Languio - @Model.Title</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bi-icons@1.0.0/font/bi-icons.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;700;900&display=swap" rel="stylesheet">

    <style>
            body {
                font-family: 'Nunito', sans-serif;
                background-color: #ffffff;
                color: #3c3c3c;
            }
            .dl-option-btn {
                width: 100%;
                text-align: left;
                padding: 18px;
                font-size: 1.15rem;
                font-weight: 700;
                margin-bottom: 12px;
                border: 2px solid #e5e5e5;
                border-bottom: 4px solid #e5e5e5;
                border-radius: 16px;
                background: white;
                color: #3c3c3c;
                transition: all 0.1s ease;
            }

                .dl-option-btn:hover {
                    background-color: #f7f7f7;
                    border-color: #e5e5e5;
                }

                .dl-option-btn:active {
                    border-bottom-width: 2px;
                    transform: translateY(2px);
                }
                .dl-option-btn.selected {
                    border-color: #1cb0f6;
                    border-bottom-color: #1899d6;
                    background-color: #ddf4ff;
                    color: #1cb0f6;
                }
            .btn-3d {
                border-radius: 16px;
                font-weight: 900;
                letter-spacing: 0.8px;
                transition: all 0.1s ease;
            }

            .btn-3d-gray {
                background-color: #e5e5e5;
                color: #afafaf;
                border: none;
                border-bottom: 4px solid #ccc;
            }

            .btn-3d-green {
                background-color: #58cc02;
                color: white;
                border: none;
                border-bottom: 4px solid #46a302;
            }

                .btn-3d-green:hover {
                    background-color: #61e002;
                    color: white;
                }

                .btn-3d-green:active {
                    border-bottom-width: 0px;
                    transform: translateY(4px);
                }
            .result-panel {
                position: fixed;
                bottom: 0;
                left: 0;
                right: 0;
                padding: 30px 0;
                z-index: 1000;
                display: none;
                border-top: 2px solid #e5e5e5;
            }

            .result-success {
                background-color: #d7ffb8;
                border-top-color: #b8f28b;
                color: #58a700;
            }

            .result-danger {
                background-color: #ffd3d3;
                border-top-color: #ffb3b3;
                color: #ea2b2b;
            }
    </style>
</head>
<body>

    <div class="container mt-5" style="max-width: 650px; padding-bottom: 150px;">

        <div class="d-flex align-items-center justify-content-between mb-5">
            <a href="/" class="btn-close fs-5 text-secondary" aria-label="Close"></a>

            <div class="progress flex-grow-1 mx-4" style="height: 18px; border-radius: 10px; background-color: #e5e5e5;">
                <div id="progress-bar" class="progress-bar bg-success" role="progressbar" style="width: 0%; border-radius: 10px; transition: width 0.3s ease;"></div>
            </div>

            <div class="fs-4 fw-extrabold text-danger d-flex align-items-center gap-1">
                ❤️ <span id="lives-count">5</span>
            </div>
        </div>

        <div id="quiz-container">
            <span id="question-type-badge" class="text-uppercase fw-900 text-secondary small tracking-wide d-block mb-2" style="font-weight: 900; letter-spacing: 1px;">
                ВИБЕРІТЬ ПРАВИЛЬНИЙ ВАРІАНТ
            </span>

            <h2 id="prompt-text" class="fw-black mb-4" style="font-weight: 900; font-size: 1.75rem;">Завантаження...</h2>

            <div id="options-box" class="mt-4"></div>
        </div>
    </div>

    <div id="action-panel" class="bg-white border-top border-2 p-4 fixed-bottom">
        <div class="container" style="max-width: 650px;">
            <div class="d-flex justify-content-between align-items-center" id="panel-content-default">
                <div></div> <button id="check-btn" class="btn btn-3d btn-3d-gray px-5 py-3 text-uppercase fs-6" disabled>
                Перевірити
            </button>
        </div>

        <div class="d-none justify-content-between align-items-center" id="panel-content-result">
            <div class="d-flex align-items-center gap-3">
                <div id="result-icon-box" class="fs-2"></div>
                <div>
                    <h4 id="result-title" class="fw-black m-0" style="font-weight: 900;">Правильно!</h4>
                    <p id="result-message" class="m-0 small fw-bold"></p>
                </div>
            </div>
            <button id="next-btn" class="btn btn-3d px-5 py-3 text-uppercase fs-6">
                Продовжити
            </button>
        </div>
    </div>
</div>

<script>
        const questions = @Html.Raw(Json.Serialize(Model.Questions));

        let currentQuestionIndex = 0;
        let selectedOptionId = null;
        let lives = 5;
        let correctAnswersCount = 0;

        const typeBadge = document.getElementById('question-type-badge');
        const promptText = document.getElementById('prompt-text');
        const optionsBox = document.getElementById('options-box');
        const checkBtn = document.getElementById('check-btn');
        const nextBtn = document.getElementById('next-btn');
        const progressBar = document.getElementById('progress-bar');
        const livesCount = document.getElementById('lives-count');

        const actionPanel = document.getElementById('action-panel');
        const panelDefault = document.getElementById('panel-content-default');
        const panelResult = document.getElementById('panel-content-result');
        const resultIconBox = document.getElementById('result-icon-box');
        const resultTitle = document.getElementById('result-title');

        function renderQuestion() {
            selectedOptionId = null;

            actionPanel.className = "bg-white border-top border-2 p-4 fixed-bottom";
            panelDefault.classList.remove('d-none');
            panelDefault.classList.add('d-flex');
            panelResult.classList.remove('d-flex');
            panelResult.classList.add('d-none');

            checkBtn.className = "btn btn-3d btn-3d-gray px-5 py-3 text-uppercase fs-6";
            checkBtn.disabled = true;

            const currentQuestion = questions[currentQuestionIndex];

            if (currentQuestion.type === 0 || currentQuestion.type === "MultipleChoice") {
                typeBadge.innerText = "Виберіть правильний варіант";
            } else if (currentQuestion.type === 1 || currentQuestion.type === "Translation") {
                typeBadge.innerText = "Перекладіть це речення";
            } else {
                typeBadge.innerText = "Знайдіть пари слів";
            }

            promptText.innerText = currentQuestion.promptText;
            optionsBox.innerHTML = '';

            currentQuestion.options.forEach((option, index) => {
                const btn = document.createElement('button');
                btn.className = 'dl-option-btn d-flex align-items-center';
                btn.innerHTML = `<span class="badge border text-secondary me-3" style="border-radius: 8px; padding: 6px 10px;">${index + 1}</span> <span>${option.text}</span>`;

                btn.onclick = () => selectOption(btn, option.id);
                optionsBox.appendChild(btn);
            });

            updateUi();
        }

        function selectOption(buttonElement, optionId) {
            if (panelDefault.classList.contains('d-none')) return;

            document.querySelectorAll('.dl-option-btn').forEach(btn => btn.classList.remove('selected'));
            buttonElement.classList.add('selected');

            selectedOptionId = optionId;

            checkBtn.disabled = false;
            checkBtn.className = "btn btn-3d btn-3d-green px-5 py-3 text-uppercase fs-6";
        }

        checkBtn.onclick = async function() {
            const currentQuestion = questions[currentQuestionIndex];

            try {
                const formData = new FormData();
                formData.append('questionId', currentQuestion.id);
                formData.append('selectedOptionId', selectedOptionId);

                const response = await fetch('/Lesson/CheckAnswer', {
                    method: 'POST',
                    body: formData
                });

                if (!response.ok) throw new Error("Помилка сервера");
                const result = await response.json();

                panelDefault.classList.remove('d-flex');
                panelDefault.classList.add('d-none');
                panelResult.classList.remove('d-none');
                panelResult.classList.add('d-flex');

                if (result.isCorrect) {
                    actionPanel.className = "result-panel result-success fixed-bottom d-block animate__animated animate__slideInUp";
                    resultIconBox.innerHTML = "✅";
                    resultTitle.innerText = "Чудова робота!";
                    nextBtn.className = "btn btn-3d btn-3d-green px-5 py-3 text-uppercase fs-6";
                    correctAnswersCount++;
                } else {
                    actionPanel.className = "result-panel result-danger fixed-bottom d-block animate__animated animate__slideInUp";
                    resultIconBox.innerHTML = "❌";
                    resultTitle.innerText = "Помилка:";

                    const correctOption = currentQuestion.options.find(o => o.isCorrect || o.IsCorrect);
                    document.getElementById('result-message').innerText = correctOption ? `Правильно: ${correctOption.text}` : "Неправильна відповідь";

                    nextBtn.className = "btn btn-3d px-5 py-3 text-uppercase fs-6 text-white";
                    nextBtn.style.backgroundColor = "#ea2b2b";
                    nextBtn.style.borderBottom = "4px solid #b81d1d";

                    lives--;
                    if (lives <= 0) {
                        livesCount.innerText = "0";
                        setTimeout(() => {
                            alert("Упс! Закінчилися життя. Спробуйте пройти урок знову.");
                            window.location.href = "/"; 
                        }, 300);
                        return;
                    }
                }

            } catch (error) {
                console.error(error);
                alert("Сталася помилка при перевірці.");
            }
        };

        nextBtn.onclick = function() {
            currentQuestionIndex++;

            if (currentQuestionIndex < questions.length) {
                renderQuestion();
            } else {
                actionPanel.classList.add('d-none');
                progressBar.style.width = "100%";

                document.getElementById('quiz-container').innerHTML = `
                    <div class="text-center p-5 mt-4 animate__animated animate__bounceIn">
                        <h1 style="font-size: 4rem;">🎉</h1>
                        <h2 class="fw-black text-success mb-3" style="font-weight: 900;">Урок успішно завершено!</h2>
                        <p class="fs-5 text-secondary fw-bold">Ви відповіли правильно на ${correctAnswersCount} з ${questions.length} питань.</p>
                        <button onclick="completeLesson()" class="btn btn-3d btn-3d-green mt-4 px-5 py-3 text-uppercase fs-6">
                            Отримати нагороду
                        </button>
                    </div>
                `;
            }
        };

        function updateUi() {
            livesCount.innerText = lives;
            const progressPercent = (currentQuestionIndex / questions.length) * 100;
            progressBar.style.width = `${progressPercent}%`;
        }

        renderQuestion();

        async function completeLesson() {
            const response = await fetch('/Lesson/CompleteLesson?lessonId=@Model.Id', { method: 'POST' });
            if (response.ok) {
                window.location.href = '/Learn';
            }
        }
</script>

</body>
</html>