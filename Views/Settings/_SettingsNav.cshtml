@{
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}

<div class="fw-extrabold text-secondary text-uppercase small mb-1 px-2" style="letter-spacing: 0.8px;">
    Налаштування
</div>

<nav class="nav flex-column gap-2 left-sidebar">
    <a asp-controller="Settings" asp-action="Account"
       class="nav-link d-flex align-items-center gap-3 px-3 py-3 rounded-4 fw-extrabold text-uppercase @(currentAction == "Account" ? "active" : "")">
        <i class="bi bi-sliders fs-4 text-primary"></i> Параметри
    </a>
    <a asp-controller="Settings" asp-action="Profile"
       class="nav-link d-flex align-items-center gap-3 px-3 py-3 rounded-4 fw-extrabold text-uppercase @(currentAction == "Profile" ? "active" : "")">
        <i class="bi bi-person-circle fs-4 text-info"></i> Профіль
    </a>
    <a asp-controller="Settings" asp-action="Courses"
       class="nav-link d-flex align-items-center gap-3 px-3 py-3 rounded-4 fw-extrabold text-uppercase @(currentAction == "Courses" ? "active" : "")">
        <i class="bi bi-mortarboard-fill fs-4 text-success"></i> Курси
    </a>
</nav>