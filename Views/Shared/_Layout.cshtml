<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="view-transition" content="same-origin">
    <title>@ViewData["Title"] - Languio</title>

    <script>
            (function () {
                const saved = localStorage.getItem('theme');
                if (saved === 'dark' || saved === 'light') {
                    document.documentElement.setAttribute('data-theme', saved);
                }
            })();
    </script>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/flag-icons/7.2.3/css/flag-icons.min.css" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

    <nav class="d-flex d-lg-none align-items-center justify-content-between px-3 py-3 border-bottom border-2 border-light-subtle bg-white sticky-top">
        <button class="btn btn-light border-0 p-1" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileNav" aria-controls="mobileNav">
            <i class="bi bi-list fs-2 text-dark"></i>
        </button>
        <div class="logo fw-extrabold text-success fs-3" style="letter-spacing: -1.5px;" onclick="location.href='/'">languio</div>
        <span style="width: 40px;"></span>
    </nav>

    <div class="offcanvas offcanvas-start bg-white text-dark d-lg-none" tabindex="-1" id="mobileNav" aria-labelledby="mobileNavLabel">
        <div class="offcanvas-header border-bottom border-2 border-light-subtle">
            <span class="logo fw-extrabold text-success fs-3" style="letter-spacing: -1.5px;">languio</span>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body d-flex flex-column justify-content-between">
            <partial name="_LeftNav" />
        </div>
    </div>

    <div class="container-fluid min-vh-100 bg-white font-sans text-dark m-0 p-0">
        <div class="row min-vh-100 g-0">

            <aside class="d-none d-lg-flex col-lg-2 border-end border-2 border-light-subtle px-4 py-4 flex-column justify-content-between dl-sticky-aside order-1">
                <partial name="_LeftNav" />
            </aside>

            <main class="col-12 col-lg-7 py-4 px-3 px-lg-5 overflow-auto bg-white order-2">
                <div class="mx-auto position-relative py-2" style="max-width: 560px;">
                    @RenderBody()
                </div>
            </main>

            <aside class="col-12 col-lg-3 border-2 border-light-subtle py-4 px-4 bg-white d-flex flex-column gap-4 dl-sticky-aside dl-right-aside order-3">
                @if (IsSectionDefined("RightSidebar"))
                {
                    @RenderSection("RightSidebar", required: false)
                }
            </aside>

        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        document.addEventListener('click', function (e) {
        const link = e.target.closest('a');
        if (!link) return;
        if (link.target === '_blank' || link.hasAttribute('download')) return;
        if (link.origin !== window.location.origin) return;
        if (e.ctrlKey || e.metaKey || e.shiftKey) return;

        e.preventDefault();
        document.body.classList.add('fade-out');
        setTimeout(function () {
        window.location.href = link.href;
        }, 150);
        });
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>
