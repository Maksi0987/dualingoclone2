<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="view-transition" content="same-origin">
    <title>@ViewData["Title"] - Languio</title>

    <script>
            (function () {
                const saved = localStorage.getItem('theme');
                if (saved === 'dark' || saved === 'light') {
                    document.documentElement.setAttribute('data-theme', saved);
                }
            })();
    </script>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/flag-icons/7.2.3/css/flag-icons.min.css" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

    <div class="container-fluid min-vh-100 bg-white font-sans text-dark m-0 p-0">
        <div class="row min-vh-100 g-0">

            <aside class="col-lg-2 col-md-3 border-end border-2 border-light-subtle px-4 py-4 d-flex flex-column justify-content-between position-sticky top-0 h-100vh">
                <div>
                    <div class="logo fw-extrabold text-success fs-1 px-2 mb-4 pb-2" style="letter-spacing: -2px; font-family: 'Nunito', sans-serif;">
                        languio
                    </div>
                    <nav class="nav flex-column gap-2 left-sidebar">
                        <a asp-controller="Learn" asp-action="Index"
                           class="nav-link d-flex align-items-center gap-3 px-3 py-3 rounded-4 fw-extrabold text-uppercase @(ViewContext.RouteData.Values["controller"]?.ToString() == "Learn" ? "active" : "")">
                            <i class="bi bi-house-door-fill fs-4 text-primary"></i> Навчання
                        </a>
                        <div class="nav-item position-relative dl-more-menu-container">
                            <a href="#" class="nav-link d-flex align-items-center gap-3 px-3 py-3 rounded-4 fw-extrabold text-uppercase">
                                <i class="bi bi-three-dots fs-4 text-secondary"></i> Більше
                            </a>

                            <div class="dl-more-menu shadow p-3 bg-white border border-2 border-light-subtle">
                                <a asp-controller="Settings" asp-action="Account"
                                   class="nav-link d-flex align-items-center gap-3 px-3 py-3 rounded-4 fw-extrabold text-uppercase mb-1 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Settings" ? "active" : "")">
                                    <i class="bi bi-gear-fill fs-4 text-secondary"></i> Налаштування
                                </a>

                                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0 p-0">
                                    <button type="submit" class="nav-link d-flex align-items-center gap-3 px-3 py-3 rounded-4 fw-extrabold text-uppercase w-100 border-0 bg-transparent text-start dl-logout-btn">
                                        <i class="bi bi-box-arrow-right fs-4 text-danger"></i> Вийти
                                    </button>
                                </form>
                            </div>
                        </div>
                    </nav>
                </div>

                <div class="px-2">
                    <a asp-controller="Admin" asp-action="Index" class="btn btn-3d-light text-uppercase fw-extrabold py-3 rounded-4 w-100 border-2 d-flex align-items-center justify-content-center gap-2">
                        <i class="bi bi-gear-fill"></i> Адмінка
                    </a>
                </div>
            </aside>

            <main class="col-lg-7 col-md-6 py-4 px-lg-5 overflow-auto bg-white">
                <div class="mx-auto position-relative py-2" style="max-width: 560px;">
                    @RenderBody()
                </div>
            </main>

            <aside class="col-lg-3 col-md-3 border-start border-2 border-light-subtle py-4 px-4 bg-white d-flex flex-column gap-4 position-sticky top-0 h-100vh">
                @RenderSection("RightSidebar", required: false)
            </aside>

        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        document.addEventListener('click', function (e) {
        const link = e.target.closest('a');
        if (!link) return;
        if (link.target === '_blank' || link.hasAttribute('download')) return;
        if (link.origin !== window.location.origin) return;
        if (e.ctrlKey || e.metaKey || e.shiftKey) return;

        e.preventDefault();
        document.body.classList.add('fade-out');
        setTimeout(function () {
        window.location.href = link.href;
        }, 150);
        });
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>