<div>
    <div class="logo fw-extrabold text-success fs-1 px-2 mb-4 pb-2" style="letter-spacing: -2px; font-family: 'Nunito', sans-serif;">
        languio
    </div>
    <nav class="nav flex-column gap-2 left-sidebar">
        <a asp-controller="Learn" asp-action="Index"
           class="nav-link d-flex align-items-center gap-3 px-3 py-3 rounded-4 fw-extrabold text-uppercase @(ViewContext.RouteData.Values["controller"]?.ToString() == "Learn" ? "active" : "")">
            <i class="bi bi-house-door-fill fs-4 text-primary"></i> Навчання
        </a>
        <div class="nav-item position-relative dl-more-menu-container">
            <a class="nav-link d-flex align-items-center gap-3 px-3 py-3 rounded-4 fw-extrabold text-uppercase">
                <i class="bi bi-three-dots fs-4 text-secondary"></i> Більше
            </a>

            <div class="dl-more-menu shadow p-3 bg-white border border-2 border-light-subtle">
                <a asp-controller="Settings" asp-action="Account"
                   class="nav-link d-flex align-items-center gap-3 px-3 py-3 rounded-4 fw-extrabold text-uppercase mb-1 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Settings" ? "active" : "")">
                    <i class="bi bi-gear-fill fs-4 text-secondary"></i> Налаштування
                </a>

                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0 p-0">
                    <button type="submit" class="nav-link d-flex align-items-center gap-3 px-3 py-3 rounded-4 fw-extrabold text-uppercase w-100 border-0 bg-transparent text-start dl-logout-btn">
                        <i class="bi bi-box-arrow-right fs-4 text-danger"></i> Вийти
                    </button>
                </form>
            </div>
        </div>
    </nav>
</div>

<div class="px-2">
    <a asp-controller="Admin" asp-action="Index" class="btn btn-3d-light text-uppercase fw-extrabold py-3 rounded-4 w-100 border-2 d-flex align-items-center justify-content-center gap-2">
        <i class="bi bi-gear-fill"></i> Адмінка
    </a>
</div>
