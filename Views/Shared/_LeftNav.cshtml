<ul class="nav flex-column gap-2 mt-4 w-100">

    <!-- Кнопка Навчання -->
    <li class="nav-item">
        <a asp-controller="Learn" asp-action="Index" class="nav-link d-flex align-items-center gap-3 px-3 py-3 rounded-4 fw-extrabold text-uppercase @(ViewContext.RouteData.Values["controller"]?.ToString() == "Learn" ? "active text-primary bg-primary-subtle" : "text-secondary")">
            <i class="bi bi-house-door-fill fs-4"></i> Навчання
        </a>
    </li>

    <!-- Кнопка Крамниця -->
    <li class="nav-item">
        <a asp-controller="Store" asp-action="Index" class="nav-link d-flex align-items-center gap-3 px-3 py-3 rounded-4 fw-extrabold text-uppercase @(ViewContext.RouteData.Values["controller"]?.ToString() == "Store" ? "active text-primary bg-primary-subtle" : "text-secondary")">
            <i class="bi bi-shop fs-4"></i> Крамниця
        </a>
    </li>

    <!-- Кнопка Профіль (Виправлено посилання на Settings Controller) -->
    <li class="nav-item">
        <a asp-controller="Settings" asp-action="Profile" class="nav-link d-flex align-items-center gap-3 px-3 py-3 rounded-4 fw-extrabold text-uppercase @(ViewContext.RouteData.Values["action"]?.ToString() == "Profile" ? "active text-primary bg-primary-subtle" : "text-secondary")">
            <i class="bi bi-person-fill fs-4"></i> Профіль
        </a>
    </li>

    <!-- Кнопка Налаштування (Вказує на Account Action в Settings) -->
    <li class="nav-item">
        <a asp-controller="Settings" asp-action="Account" class="nav-link d-flex align-items-center gap-3 px-3 py-3 rounded-4 fw-extrabold text-uppercase @(ViewContext.RouteData.Values["action"]?.ToString() == "Account" ? "active text-primary bg-primary-subtle" : "text-secondary")">
            <i class="bi bi-gear-fill fs-4"></i> Налаштування
        </a>
    </li>

    <!-- Адмінка (Відображається тільки якщо користувач має роль Admin) -->
    @if (User.IsInRole("Admin"))
    {
        <li class="nav-item mt-3">
            <a asp-controller="Admin" asp-action="Index" class="nav-link d-flex align-items-center gap-3 px-3 py-3 rounded-4 fw-extrabold text-uppercase text-dark border border-2">
                <i class="bi bi-gear-fill fs-4"></i> Адмінка
            </a>
        </li>
    }

    <!-- Кнопка Вихід (через форму для безпеки) -->
    <li class="nav-item mt-3">
        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0 p-0 w-100">
            <button type="submit" class="nav-link w-100 d-flex align-items-center gap-3 px-3 py-3 rounded-4 fw-extrabold text-uppercase text-danger bg-transparent border-0" style="text-align: left;">
                <i class="bi bi-box-arrow-right fs-4"></i> Вихід
            </button>
        </form>
    </li>

</ul>