@model languio.Models.ForgotPasswordViewModel
@{ Layout = null; }
<!DOCTYPE html>
<html>
<head>
    <title>Відновлення пароля</title>
    <style>
        body { font-family: sans-serif; display: flex; justify-content: center; align-items: center; min-height: 100vh; margin: 0; background: #fff; color: #3c3c3c; }
        .box { width: 100%; max-width: 400px; padding: 20px; text-align: center; }
        .form-control { width: 100%; padding: 14px; margin-bottom: 15px; border: 2px solid #e5e5e5; border-radius: 12px; background: #f7f7f7; outline: none; font-size: 16px; box-sizing: border-box;}
        .btn { width: 100%; background: #1cb0f6; color: white; border: none; border-radius: 16px; padding: 15px; font-weight: bold; text-transform: uppercase; cursor: pointer; border-bottom: 4px solid #1899d6; }
    </style>
</head>
<body>
    <div class="box">
        <h2>Відновлення пароля</h2>
        <p>Введіть ваш Email для отримання посилання.</p>
        <form asp-action="ForgotPassword" method="post">
            <input asp-for="Email" class="form-control" placeholder="Ел. адреса" required />
            <button type="submit" class="btn">Надіслати</button>
        </form>
    </div>
</body>
</html>