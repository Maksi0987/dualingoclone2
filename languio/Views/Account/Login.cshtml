@model languio.Models.LoginViewModel
@{
    Layout = null; // Повністю чиста сторінка без стандартного шаблону сайту
}

<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Вхід - languio</title>
    <style>
        * { box-sizing: border-box; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        body { margin: 0; padding: 0; background-color: #ffffff; display: flex; justify-content: center; align-items: center; min-height: 100vh; color: #4b4b4b; position: relative; }
        
        /* Кнопка реєстрації в правому верхньому кутку */
        .top-right-btn { position: absolute; top: 20px; right: 20px; text-decoration: none; color: #1cb0f6; font-weight: bold; border: 2px solid #e5e5e5; border-radius: 16px; padding: 10px 20px; font-size: 14px; text-transform: uppercase; transition: 0.2s; }
        .top-right-btn:hover { background-color: #f3f4f6; }

        /* Головний контейнер форми */
        .login-container { width: 100%; max-width: 400px; padding: 20px; text-align: center; }
        h1 { font-size: 24px; margin-bottom: 30px; color: #3c3c3c; }

        /* Поля введення */
        .form-group { position: relative; margin-bottom: 15px; text-align: left; width: 100%; }
        .form-control { width: 100%; padding: 14px 16px; font-size: 16px; border: 2px solid #e5e5e5; border-radius: 12px; background-color: #f7f7f7; outline: none; transition: 0.2s; }
        .form-control:focus { border-color: #84d8ff; background-color: #ffffff; }
        .form-control::placeholder { color: #afafaf; font-weight: 500; }

        /* Контейнер для поля пароля з елементами керування */
        .password-wrapper { position: relative; display: flex; align-items: center; width: 100%; margin-bottom: 15px; }

        /* Кнопка-око (Глазік) */
        .toggle-password { 
            position: absolute; 
            right: 90px; /* Зсунуто вліво, щоб звільнити місце для кнопки "Забули?" */
            background: none; 
            border: none; 
            cursor: pointer; 
            color: #afafaf; 
            padding: 0; 
            display: flex; 
            align-items: center; 
            justify-content: center; 
            outline: none; 
            transition: 0.2s;
            z-index: 10;
        }
        .toggle-password:hover { color: #1cb0f6; }
        .toggle-password svg { width: 22px; height: 22px; fill: currentColor; }

        /* Посилання Забули пароль всередині поля */
        .forgot-link { position: absolute; right: 15px; top: 50%; transform: translateY(-50%); text-decoration: none; color: #afafaf; font-size: 14px; font-weight: bold; text-transform: uppercase; letter-spacing: 1px; z-index: 10; }
        .forgot-link:hover { color: #1cb0f6; }

        /* Головна кнопка Увійти з Duolingo-тінню */
        .btn-primary { display: block; width: 100%; background-color: #1cb0f6; color: white; text-transform: uppercase; font-size: 16px; font-weight: bold; border: none; border-radius: 16px; padding: 15px; margin-top: 20px; cursor: pointer; border-bottom: 4px solid #1899d6; transition: 0.1s; text-decoration: none; }
        .btn-primary:active { border-bottom: 0px solid #1899d6; transform: translateY(4px); margin-bottom: 4px; }

        /* Розділювач АБО */
        .divider { display: flex; align-items: center; text-align: center; margin: 30px 0; color: #afafaf; font-size: 14px; font-weight: bold; }
        .divider::before, .divider::after { content: ''; flex: 1; border-bottom: 2px solid #e5e5e5; }
        .divider:not(:empty)::before { margin-right: .25em; }
        .divider:not(:empty)::after { margin-left: .25em; }

        /* Соціальні кнопки */
        .social-buttons { display: flex; justify-content: space-between; gap: 15px; width: 100%; }
        .btn-social { flex: 1; display: flex; justify-content: center; align-items: center; gap: 8px; font-weight: bold; font-size: 14px; color: #3b5998; border: 2px solid #e5e5e5; border-radius: 16px; padding: 12px; text-decoration: none; text-transform: uppercase; transition: 0.2s; cursor: pointer; background: white; }
        .btn-social.google { color: #4285F4; }
        .btn-social:hover { background-color: #f3f4f6; }

        /* Текст підвалу */
        .footer-text { margin-top: 40px; font-size: 12px; color: #afafaf; line-height: 1.5; }
        .footer-text a { color: #afafaf; font-weight: bold; text-decoration: none; }
        .text-danger { color: #ff4b4b; font-size: 14px; margin-bottom: 15px; display: block; text-align: center; }
        
        form { margin: 0; padding: 0; width: 100%; }
    </style>
</head>
<body>

    <a asp-action="Register" class="top-right-btn">Зареєструватися</a>

    <div class="login-container">
        <h1>Вхід</h1>

        <form asp-action="Login" method="post">
            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="form-group">
                <input asp-for="EmailOrUsername" class="form-control" placeholder="Ел. адреса або ім'я користувача" required />
            </div>

            <div class="password-wrapper">
                <input asp-for="Password" class="form-control" placeholder="Пароль" required id="PasswordField" style="padding-right: 155px;" />
                
                <button type="button" class="toggle-password" id="TogglePasswordBtn" title="Показати/Сховати пароль">
                    <svg id="EyeIcon" viewBox="0 0 24 24">
                        <path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/>
                    </svg>
                </button>

                <a asp-action="ForgotPassword" class="forgot-link">Забули?</a>
            </div>

            <button type="submit" class="btn-primary">Увійти</button>
        </form>

        <div class="divider">АБО</div>

        <div class="social-buttons">
            <form asp-action="ExternalLogin" method="post" style="display:inline-flex; width:100%; gap:15px;">
                <button type="submit" name="provider" value="Google" class="btn-social google">
                    <svg width="18" height="18" viewBox="0 0 24 24"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg>
                    Google
                </button>
                <button type="button" class="btn-social">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="#3b5998"><path d="M22.675 0H1.325C.593 0 0 .593 0 1.325v21.351C0 23.407.593 24 1.325 24H12.82v-9.294H9.692v-3.622h3.128V8.413c0-3.1 1.893-4.788 4.659-4.788 1.325 0 2.463.099 2.795.143v3.24l-1.918.001c-1.504 0-1.795.715-1.795 1.763v2.313h3.587l-.467 3.622h-3.12V24h6.116c.73 0 1.323-.593 1.323-1.325V1.325C24 .593 23.407 0 22.675 0z"/></svg>
                    Facebook
                </button>
            </form>
        </div>

        <div class="footer-text">
            Увійшовши в Duolingo, ви приймаєте наші <a href="#">умови</a> та <a href="#">Політику конфіденційності</a>.<br><br>
            Цей сайт захищено сервісом reCAPTCHA Enterprise, застосовуються <a href="#">Політика конфіденційності</a> та <a href="#">Умови використання</a> Google.
        </div>
    </div>

    <script>
        const toggleBtn = document.getElementById('TogglePasswordBtn');
        const passwordField = document.getElementById('PasswordField');
        const eyeIcon = document.getElementById('EyeIcon');

        // SVG шлях для відкритого ока
        const openEyePath = "M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z";
        
        // SVG шлях для перекресленого ока
        const closedEyePath = "M12 7c2.76 0 5 2.24 5 5 0 .65-.13 1.26-.36 1.83l2.92 2.92c1.51-1.26 2.7-2.89 3.43-4.75-1.73-4.39-6-7.5-11-7.5-1.4 0-2.74.25-3.98.7l2.16 2.16C10.74 7.13 11.35 7 12 7zM2 4.27l2.28 2.28.46.46C3.08 8.3 1.78 10.02 1 12c1.73 4.39 6 7.5 11 7.5 1.55 0 3.03-.3 4.38-.84l.42.42L19.73 22 21 20.73 3.27 3 2 4.27zM7.53 9.8l1.55 1.55c-.05.21-.08.43-.08.65 0 1.66 1.34 3 3 3 .22 0 .44-.03.65-.08l1.55 1.55c-.67.33-1.41.53-2.2.53-2.76 0-5-2.24-5-5 0-.79.2-1.53.53-2.2zm4.31-.78l3.15 3.15.02-.16c0-1.66-1.34-3-3-3l-.17.01z";

        toggleBtn.addEventListener('click', function () {
            if (passwordField.type === 'password') {
                passwordField.type = 'text'; // Показуємо текст пароля
                eyeIcon.innerHTML = `<path d="${closedEyePath}"/>`; // Перемикаємо на закрите око
            } else {
                passwordField.type = 'password'; // Ховаємо назад у крапочки
                eyeIcon.innerHTML = `<path d="${openEyePath}"/>`; // Повертаємо звичайне око
            }
        });
    </script>
</body>
</html>