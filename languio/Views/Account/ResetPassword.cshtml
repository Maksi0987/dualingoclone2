@model languio.Models.ResetPasswordViewModel
@{ Layout = null; }
<!DOCTYPE html>
<html>
<head>
    <title>Новий пароль</title>
    <style>
        body { font-family: sans-serif; display: flex; justify-content: center; align-items: center; min-height: 100vh; margin: 0; background: #fff; }
        .box { width: 100%; max-width: 400px; padding: 20px; text-align: center; }
        .form-control { width: 100%; padding: 14px; margin-bottom: 15px; border: 2px solid #e5e5e5; border-radius: 12px; background: #f7f7f7; outline: none; font-size: 16px; box-sizing: border-box;}
        .btn { width: 100%; background: #58cc02; color: white; border: none; border-radius: 16px; padding: 15px; font-weight: bold; text-transform: uppercase; cursor: pointer; border-bottom: 4px solid #46a302; }
        .text-danger { color: #ff4b4b; }
    </style>
</head>
<body>
    <div class="box">
        <h2>Введіть новий пароль</h2>
        <form asp-action="ResetPassword" method="post">
            <div asp-validation-summary="All" class="text-danger"></div>
            <input type="hidden" asp-for="Code" />
            <input type="hidden" asp-for="Email" />
            
            <input asp-for="Password" class="form-control" placeholder="Новий пароль" required />
            <input asp-for="ConfirmPassword" class="form-control" placeholder="Підтвердіть пароль" required />
            <button type="submit" class="btn">Оновити пароль</button>
        </form>
    </div>
</body>
</html>