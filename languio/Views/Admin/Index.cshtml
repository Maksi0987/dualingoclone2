@model IEnumerable<Languio.Models.LanguageCourse>
@{
    ViewData["Title"] = "Адмінка - Курси";
}

<div class="container-fluid min-vh-100 bg-white text-dark p-5">
    <div class="mx-auto" style="max-width: 900px;">

        <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom border-2 border-light-subtle">
            <h1 class="h3 fw-extrabold text-dark m-0 d-flex align-items-center gap-2" style="font-family: 'Nunito', sans-serif;">
                <span class="fs-4">📚</span> Управління курсами
            </h1>
            <a asp-controller="Admin" asp-action="CreateCourse" class="btn btn-3d-green text-uppercase fw-extrabold px-4 py-2 rounded-3 fs-7 text-decoration-none">
                + Додати курс
            </a>
        </div>

        <div class="d-flex flex-column gap-3">
            @if (!Model.Any())
            {
                <div class="p-5 text-center text-secondary border border-2 border-dashed border-secondary-subtle rounded-4 bg-light bg-opacity-50">
                    Курсів поки немає. Натисніть "+ Додати курс", щоб створити перший.
                </div>
            }
            @foreach (var course in Model)
            {
                <a asp-action="Groups" asp-route-courseId="@course.Id" class="rounded-4 border-2 p-4 d-flex justify-content-between align-items-center dl-light-row text-decoration-none">
                    <div class="d-flex align-items-center gap-3">
                        <span class="fs-2">🌐</span>
                        <div>
                            <h5 class="fw-extrabold m-0 text-dark text-uppercase" style="letter-spacing: 0.5px;">Курс: @course.LanguageCode</h5>
                            <small class="text-secondary fw-bold small">Керування розділами, словником та структурою уроків</small>
                        </div>
                    </div>
                    <div class="text-success fw-extrabold fs-5 pe-2">
                        <i class="bi bi-chevron-right"></i>
                    </div>
                </a>
            }
        </div>

    </div>
</div>