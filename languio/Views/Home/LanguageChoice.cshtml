@model Languio.Models.ChooseLanguageViewModel

@{
    ViewData["Title"] = "Яку мову ви хочете вчити?";
}

<div class="bg-white text-dark min-vh-100 d-flex flex-column justify-content-between">

    <header class="container d-flex justify-content-between align-items-center py-4 px-3">
        <div class="logo fw-bold text-success fs-2" style="letter-spacing: -1px; cursor:pointer;" onclick="location.href='/'">languio</div>
        <div class="dropdown">
            <button class="btn btn-link text-secondary text-uppercase fw-bold text-decoration-none dropdown-toggle small" type="button" data-bs-toggle="dropdown">
                Мова сайту: Українська
            </button>
            <ul class="dropdown-menu">
                <li><a class="dropdown-item" href="#">Українська</a></li>
            </ul>
        </div>
    </header>

    <main class="container my-auto py-5" style="max-width: 1000px;">
        <h1 class="text-center fw-bold h3 mb-5 text-dark-emphasis">Яку мову ви хочете вчити?</h1>

        <form id="langForm" method="post" action="/LanguageChoice">
            <input type="hidden" id="selectedLangInput" name="lang" value="" />

            <div class="row row-cols-2 row-cols-sm-2 row-cols-md-4 g-4 justify-content-center">
                @foreach (var lang in Model.Languages)
                {
                    <div class="col">
                        <div class="card lang-card h-100 text-center p-4 border border-2 rounded-4 shadow-sm"
                             style="cursor: pointer;"
                             onclick="submitLanguage('@lang.Code')">

                            <div class="flag-icon display-3 my-3">@lang.FlagEmoji</div>

                            <div class="card-body p-0">
                                <h5 class="card-title fw-bold fs-6 mb-1 text-secondary-emphasis">@lang.Name</h5>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </form>
    </main>

    <footer class="py-4"></footer>
</div>

@section Scripts {
    <script>
        function submitLanguage(langCode) {
            localStorage.setItem("current_lang", langCode);

            document.getElementById("selectedLangInput").value = langCode;
            document.getElementById("langForm").submit();
        }
    </script>
}