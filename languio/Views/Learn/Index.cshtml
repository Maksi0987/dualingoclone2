@model Languio.Models.LearnViewModel

@{
    ViewData["Title"] = "Навчання";
}

<div class="d-flex duo-wrapper text-white min-vh-100">

    <aside class="left-sidebar d-none d-xl-flex flex-column p-4 border-end border-secondary-subtle" style="width: 250px; min-width: 250px;">
        <div class="logo fw-bold text-success fs-2 mb-4">languio</div>
        <nav class="nav flex-column gap-2 w-100">
            <a href="#" class="nav-link active d-flex align-items-center gap-3 p-3 rounded-4 text-white fw-bold bg-dark border border-secondary">
                <i class="bi bi-house-door-fill text-success fs-4"></i> НАВЧАННЯ
            </a>
            <a href="#" class="nav-link d-flex align-items-center gap-3 p-3 rounded-4 text-secondary fw-bold">
                <i class="bi bi-shield-shaded fs-4"></i> ДОШКИ ПОШАНИ
            </a>
            <a href="#" class="nav-link d-flex align-items-center gap-3 p-3 rounded-4 text-secondary fw-bold">
                <i class="bi bi-scroll fs-4"></i> КВЕСТІ ДНЯ
            </a>
            <a href="#" class="nav-link d-flex align-items-center gap-3 p-3 rounded-4 text-secondary fw-bold">
                <i class="bi bi-shop fs-4"></i> МАГАЗИН
            </a>
            <a href="#" class="nav-link d-flex align-items-center gap-3 p-3 rounded-4 text-secondary fw-bold">
                <i class="bi bi-person-circle fs-4"></i> ПРОФІЛЬ
            </a>
            <a href="#" class="nav-link d-flex align-items-center gap-3 p-3 rounded-4 text-secondary fw-bold">
                <i class="bi bi-three-dots fs-4"></i> БІЛЬШЕ
            </a>
        </nav>
    </aside>

    <main class="flex-grow-1 p-4" style="max-width: 700px; margin: 0 auto;">

        <div class="bg-success text-white p-4 rounded-4 d-flex justify-content-between align-items-center mb-5 shadow-sm">
            <div>
                <span class="text-uppercase fw-bold opacity-75 small">← @Model.ActiveSectionTitle</span>
                <h2 class="h4 fw-bold m-0 mt-1">@Model.ActiveSectionDescription</h2>
            </div>
            <button class="btn btn-outline-light border-2 rounded-3 fw-bold px-3 py-2 d-flex align-items-center gap-2">
                <i class="bi bi-book"></i> ПОСІБНИК
            </button>
        </div>

        <div class="learning-map d-flex flex-column align-items-center gap-4 position-relative">
            @foreach (var item in Model.MapItems.OrderBy(i => i.Order))
            {
                // Bootstrap утиліти для зміщення (імітація змійки)
                string positionClass = item.Order % 2 == 0 ? "me-auto ps-5" : "ms-auto pe-5";
                if (item.Order % 3 == 0) positionClass = "mx-auto";

                <div class="position-relative @positionClass">
                    @if (item.Status == "Active" && item.Type == "Lesson")
                    {
                        <div class="position-absolute bg-white text-success px-3 py-1 rounded-3 fw-bold shadow-sm small text-uppercase"
                             style="top: -35px; left: 50%; transform: translateX(-50%); z-index: 10;">
                            Почати
                        </div>
                    }

                    @{
                        string btnColorClass = item.Status == "Active" ? "btn-success" : "btn-secondary text-dark opacity-50";
                        string icon = item.Type == "Chest" ? "bi-gift-fill" : (item.Type == "Cup" ? "bi-trophy-fill" : "bi-star-fill");
                    }

                    <a href="@(item.Status != "Locked" ? $"/Lesson/{item.LessonId}" : "#")"
                       class="btn @btnColorClass rounded-circle d-flex align-items-center justify-content-center shadow"
                       style="width: 75px; height: 75px; font-size: 28px;">
                        <i class="bi @icon"></i>
                    </a>
                </div>
            }
        </div>
    </main>

    <aside class="right-sidebar d-none d-lg-flex flex-column gap-4 p-4" style="width: 360px; min-width: 360px;">

        <div class="d-flex justify-content-end align-items-center gap-3 fw-bold fs-5">
            <span class="fs-4" title="Німецька">🇩🇪</span>
            <span class="text-warning d-flex align-items-center gap-1"><i class="bi bi-fire"></i> 0</span>
            <span class="text-info d-flex align-items-center gap-1"><i class="bi bi-gem"></i> 500</span>
            <span class="text-danger d-flex align-items-center gap-1"><i class="bi bi-heart-fill"></i> 5</span>
        </div>

        <div class="card bg-transparent border-secondary rounded-4 p-3 text-white">
            <h5 class="card-title fw-bold">Розблокуйте дошки пошани!</h5>
            <div class="d-flex align-items-center gap-3 mt-2">
                <i class="bi bi-lock-fill fs-1 text-secondary"></i>
                <p class="card-text text-secondary m-0 small">Пройдіть ще 3 уроки, щоб почати боротьбу.</p>
            </div>
        </div>

        <div class="card bg-transparent border-secondary rounded-4 p-3 text-white">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h5 class="card-title fw-bold m-0">Квести дня</h5>
                <a href="#" class="text-info text-decoration-none small fw-bold">УСІ</a>
            </div>
            <div class="d-flex align-items-center gap-3">
                <i class="bi bi-lightning-charge-fill text-warning fs-3"></i>
                <div class="flex-grow-1">
                    <p class="m-0 small fw-bold">Отримайте 10 балів</p>
                    <div class="progress bg-dark mt-1" style="height: 12px;">
                        <div class="progress-bar bg-warning" role="progressbar" style="width: 30%"></div>
                    </div>
                </div>
                <span class="small text-secondary fw-bold">3/10</span>
            </div>
        </div>

        <div class="card bg-transparent border-secondary rounded-4 p-3 text-center">
            <h5 class="fw-bold mb-3">Створіть профіль, щоб зберегти свій прогрес!</h5>
            <div class="d-flex flex-column gap-2">
                <button class="btn btn-success fw-bold py-2.5 rounded-3 shadow-sm text-uppercase">Створити профіль</button>
                <button class="btn btn-primary fw-bold py-2.5 rounded-3 shadow-sm text-uppercase">Увійти</button>
            </div>
        </div>
    </aside>

</div>