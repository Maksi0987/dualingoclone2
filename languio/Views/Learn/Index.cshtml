@model IEnumerable<Languio.Models.LanguageLessonGroup>

@{
    ViewData["Title"] = "Карта знань";

    // Лічильник для розрахунку "змійки" (відступів кнопок) по всьому курсу
    int globalLessonIndex = 0;
}

<div class="container-fluid min-vh-100 bg-dark text-white p-0">
    <div class="row g-0 m-0">

        <div class="col-xl-3 d-none d-xl-flex flex-column border-end border-secondary border-opacity-25 min-vh-100 p-4 position-sticky top-0" style="height: 100vh;">
            <div class="logo fw-bold text-success fs-2 mb-5" style="letter-spacing: -1px;">languio</div>
            <div class="d-flex flex-column gap-3 w-100">
                <a asp-controller="Learn" asp-action="Index" class="btn btn-outline-success border-2 fw-bold text-start py-3 px-4 rounded-4 active">
                    <i class="bi bi-house-door-fill me-3 fs-5"></i> НАВЧАННЯ
                </a>
                <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary border-0 fw-bold text-start py-3 px-4 rounded-4 text-white-50">
                    <i class="bi bi-gear-fill me-3 fs-5"></i> АДМІНІСТРАЦІЯ
                </a>
            </div>
        </div>

        <div class="col-12 col-xl-6 py-5 px-3 min-vh-100">
            <div class="mx-auto" style="max-width: 600px;">

                @if (!Model.Any())
                {
                    <div class="text-center py-5">
                        <h3 class="text-secondary">Для цього курсу ще не створено жодного модуля чи уроку.</h3>
                        <a asp-controller="Admin" asp-action="Index" class="btn btn-success fw-bold mt-3">Перейти в адмінку</a>
                    </div>
                }

                @foreach (var group in Model)
                {
                    <div class="card bg-success bg-opacity-10 border border-success border-opacity-25 rounded-4 p-4 mb-5 shadow-sm">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h2 class="h4 fw-bold text-success m-0 text-uppercase" style="letter-spacing: 1px;">
                                @group.Title
                            </h2>
                            <span class="badge bg-success bg-opacity-20 text-success border border-success border-opacity-50 px-2.5 py-1.5 rounded-3 fw-bold small">
                                Модуль #@group.Id
                            </span>
                        </div>
                        <p class="text-white-50 m-0 small">@group.Description</p>
                    </div>

                    <div class="d-flex flex-column align-items-center gap-4 mb-5">
                        @foreach (var lesson in group.Lessons.OrderBy(l => l.Order))
                        {
                            // Розрахунок змійки
                            int positionState = globalLessonIndex % 4;
                            string marginClass = positionState switch
                            {
                                1 => "me-5 pe-4",  // Зсув праворуч
                                2 => "ms-5 ps-4",  // Зсув ліворуч
                                3 => "ms-5 ps-4",  // Зсув ліворуч (повернення)
                                _ => ""            // По центру
                            };

                            // Стани уроку (для тесту: перший активний, інші — заблоковані)
                            bool isLocked = globalLessonIndex > 0;

                            // Нові класи для стилізації під Duolingo
                            string duolingoBtnClass = isLocked ? "dl-btn-locked" : "dl-btn-active";
                            string icon = isLocked ? "bi-lock-fill" : "bi-star-fill";

                            <div class="d-flex flex-column align-items-center @marginClass position-relative text-center my-1" style="width: 140px;">

                                @if (!isLocked)
                                {
                                    <div class="dl-tooltip text-uppercase fw-extrabold animate-bounce">
                                        Почати
                                    </div>
                                }

                                <a asp-controller="Lesson"
                                   asp-action="Details"
                                   asp-route-id="@lesson.Id"
                                   class="btn dl-btn @duolingoBtnClass rounded-circle d-flex align-items-center justify-content-center"
                                   style="pointer-events: @(isLocked ? "none" : "auto");">
                                    <i class="bi @icon"></i>
                                </a>
                            </div>

                            globalLessonIndex++;
                        }
                    </div>
                }

            </div>
        </div>

        <div class="col-xl-3 d-none d-xl-flex flex-column border-start border-secondary border-opacity-25 min-vh-100 p-4 position-sticky top-0" style="height: 100vh;">
            <div class="d-flex justify-content-around align-items-center bg-secondary bg-opacity-10 border border-secondary border-opacity-25 py-3 px-2 rounded-4 w-100 mb-4">
                <span class="fw-bold text-warning"><i class="bi bi-fire me-1"></i> 5</span>
                <span class="fw-bold text-info"><i class="bi bi-gem me-1"></i> 120</span>
                <span class="fw-bold text-danger"><i class="bi bi-heart-fill me-1"></i> 3</span>
            </div>
        </div>

    </div>
</div>